PORT=5001
NODE_ENV=development

# Database Configuration
DB_DIALECT=sqlite
DB_STORAGE=./dayflow.sqlite

# MySQL Settings (Uncomment and configure to switch to MySQL)
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=yourpassword
# DB_NAME=dayflow

# JWT Secrets
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
